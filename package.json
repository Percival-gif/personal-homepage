{
  "name": "percival-personal-homepage",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "preview:start": "BASE_PATH=/ npm run build && node scripts/preview-local.mjs start",
    "preview:status": "node scripts/preview-local.mjs status",
    "preview:stop": "node scripts/preview-local.mjs stop",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "audit": "node qa/lighthouse.mjs"
  },
  "dependencies": {
    "fflate": "0.8.2",
    "gsap": "3.15.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.1"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3",
    "vite": "5.4.21",
    "vitest": "2.1.9",
    "@playwright/test": "1.58.2",
    "@axe-core/playwright": "4.10.2",
    "fake-indexeddb": "6.0.1",
    "lighthouse": "12.6.1"
  }
}
